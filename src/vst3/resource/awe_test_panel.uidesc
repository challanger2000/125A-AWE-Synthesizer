<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <!-- P14 development panel: functional VST3 parameter bindings, no mock controls. -->
  <colors>
    <color name="Panel" rgba="#1e232bff"/>
    <color name="Control" rgba="#343d49ff"/>
    <color name="Muted" rgba="#a5b0bfff"/>
    <color name="Accent" rgba="#d2e2f4ff"/>
  </colors>
  <template name="view" class="CViewContainer" origin="0, 0" size="520, 240" minSize="520, 240" maxSize="520, 240" background-color="Panel" transparent="false">
    <view class="CTextLabel" origin="20, 14" size="480, 32" title="125A AWE SYNTHESIZER  |  P14 DEV" font="~ NormalFontVeryBig" font-color="Accent" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
    <view class="CTextLabel" origin="20, 54" size="115, 26" title="HARDWARE" font="~ NormalFont" font-color="Muted" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
    <view class="COptionMenu" origin="145, 52" size="350, 30" control-tag="Hardware" menu-popup-style="true" menu-check-style="false" min-value="0" max-value="2" default-value="0" back-color="Control" frame-color="Muted" frame-width="1" font="~ NormalFont" font-color="Accent" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true"/>
    <view class="CTextLabel" origin="20, 100" size="115, 26" title="PROGRAM" font="~ NormalFont" font-color="Muted" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
    <view class="COptionMenu" origin="145, 98" size="350, 30" control-tag="Program" menu-popup-style="true" menu-check-style="false" min-value="0" max-value="127" default-value="0" back-color="Control" frame-color="Muted" frame-width="1" font="~ NormalFont" font-color="Accent" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true"/>
    <view class="CTextLabel" origin="20, 145" size="475, 19" title="SF2 / ROM / IBK: existing assets.cfg configuration" font="~ NormalFontSmall" font-color="Muted" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
    <view class="CTextLabel" origin="20, 169" size="475, 19" title="Restart the plugin after changing asset paths." font="~ NormalFontSmall" font-color="Muted" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
    <view class="CTextLabel" origin="20, 203" size="475, 19" title="Factory FM: MAUIFM + Yamaha DRUM built in. CQM drums off." font="~ NormalFontSmall" font-color="Muted" back-color="Panel" frame-color="Panel" transparent="true" mouse-enabled="false"/>
  </template>
  <control-tags>
    <control-tag name="Program" tag="1000"/>
    <control-tag name="Hardware" tag="1001"/>
  </control-tags>
</vstgui-ui-description>
