<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <!-- P106: Single AWE/EMU8000 instrument. Host IDs 1000/1002 stay stable;
       1100..1111 are 0=unchanged SoundFont non-destructive overlays. -->
  <colors><color name="Panel" rgba="#181e26ff"/></colors>
  <template name="view" class="CViewContainer" origin="0, 0" size="1200, 780" minSize="1200, 780" maxSize="1200, 780" background-color="Panel" transparent="false">
    <view class="CViewContainer" custom-view-name="AwePresetBrowser" origin="0, 0" size="1200, 780" transparent="false"/>
  </template>
  <control-tags>
    <control-tag name="Program" tag="1000"/>
    <control-tag name="SF2Bank" tag="1002"/>
  </control-tags>
</vstgui-ui-description>
